# --- Capa de Base de Datos (consumidas por el servicio reservas-db) ---
# Contraseña del superusuario root de MySQL
MYSQL_ROOT_PASSWORD=cambiar_password_root_aqui
# Nombre de la base de datos a crear durante la inicialización
MYSQL_DATABASE=reservasdb
# Usuario de aplicación con privilegios sobre MYSQL_DATABASE
MYSQL_USER=usuario_reservas
# Contraseña para el usuario de aplicación
MYSQL_PASSWORD=cambiar_password_usuario_aqui

# --- Capa de Backend / API (consumidas por el servicio reservas-api) ---
# Puerto interno en el que escucha el servidor Node/Express
PORT=3000
# Hostname de la base de datos (nombre del servicio en la red de Docker)
DB_HOST=reservas-db
# Puerto TCP interno de MySQL
DB_PORT=3306
# Nombre de la base de datos a la que conecta la API
DB_NAME=reservasdb
# Credenciales de acceso de la API
DB_USER=usuario_reservas
DB_PASSWORD=cambiar_password_usuario_aqui
# Versión de la API informada en endpoints de diagnóstico
APP_VERSION=v1
# Indica si debe poblar la base con salas de prueba al iniciar (true/false)
SEED_DEMO=true

# --- Capa de Frontend (consumidas por el contenedor reservas-frontend / Nginx) ---
# Hostname de la API al cual Nginx redirige el proxy reverso (/api)
API_HOST=reservas-api
# Puerto interno de la API para el bloque upstream de Nginx
API_PORT=3000
